# Neon PostgreSQL connection string
# Get this from your Neon project dashboard -> Connection Details
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=

# xAI Grok API key — used server-side ONLY (report narratives + AI Assistant
# answer phrasing). Never sent to or read by the frontend. If unset, the app
# falls back to a deterministic, non-LLM narrative/answer instead of failing.
# Either variable name is accepted (GROK_API_KEY is preferred; GROQ_API_KEY
# is also read for backward compatibility with earlier deployments).
GROK_API_KEY=

# Comma-separated list of trusted frontend origins for cross-origin requests,
# e.g. https://dancing-caramel-606aba.netlify.app — required for the current
# split deployment (frontend on Netlify, backend on this Render service).
# CORS is enabled ONLY for the exact origins listed here (never a wildcard),
# with credentials allowed, and the session cookie is set with
# SameSite=None; Secure=True so it is actually sent on cross-origin requests
# made with fetch(..., { credentials: "include" }).
CORS_ALLOWED_ORIGINS=

# Port the FastAPI app runs on locally (optional, defaults to 8000).
# In production on Render, the platform sets $PORT automatically — see the
# Render start command in README, which reads it via the shell, not this file.
PORT=8000
